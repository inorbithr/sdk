{
  "name": "@inorbithr/ui",
  "private": true,
  "version": "0.0.0",
  "description": "The web UI that `iohr ui` serves: the shell frame and the extension panels (RFC 0217).",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    "./frame/tokens.css": "./src/frame/tokens.css",
    "./frame/shortcuts.json": "./src/frame/shortcuts.json",
    "./frame/*": {
      "types": "./lib/frame/*.d.ts",
      "default": "./lib/frame/*.js"
    }
  },
  "files": [
    "lib",
    "src/frame/tokens.css",
    "src/frame/shortcuts.json"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "lib": "tsc -p tsconfig.lib.json",
    "prepare": "pnpm run lib",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --test-reporter=spec 'test/*.test.ts'",
    "check": "biome ci . && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run lib"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "1.54.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "vite": "6.4.5"
  },
  "peerDependencies": {
    "lucide-react": "^1.54.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.1",
    "three": "0.186.1"
  }
}
