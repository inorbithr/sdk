<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>InOrbit.Sdk</RootNamespace>
    <PackageId>InOrbit.Sdk</PackageId>
    <Version>0.2.1</Version> <!-- x-release-please-version -->
    <Authors>InOrbit d.o.o.</Authors>
    <Description>The InOrbit API client: the runtime and the public surface.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/inorbithr/sdk</RepositoryUrl>
    <PackageProjectUrl>https://docs.inorbit.hr</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsAotCompatible>false</IsAotCompatible>
  </PropertyGroup>
  <ItemGroup>
    <!-- docs/config.md section 8 (SR-20): the config file's TOML, and logging through ILogger. -->
    <PackageReference Include="Tomlyn" Version="2.10.1" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.3" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="InOrbit.Sdk.Tests" />
  </ItemGroup>
</Project>
