<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The library targets net8.0; tests run it on whatever newer runtime the SDK brings. -->
    <RollForward>Major</RollForward>
    <!-- Test names read as sentences; xUnit's analyzers ask for ConfigureAwait in tests. -->
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1515</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <!-- Reads conformance/vectors; tests only. -->
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/InOrbit.Sdk/InOrbit.Sdk.csproj" />
  </ItemGroup>
</Project>
