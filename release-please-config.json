{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": true,
  "tag-separator": "/",
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "pull-request-title-pattern": "chore: release${component} ${version}",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug fixes" },
    { "type": "perf", "section": "Performance" },
    { "type": "revert", "section": "Reverts" },
    { "type": "docs", "section": "Documentation" },
    { "type": "build", "section": "Dependencies", "hidden": false },
    { "type": "refactor", "hidden": true },
    { "type": "test", "hidden": true },
    { "type": "ci", "hidden": true },
    { "type": "chore", "hidden": true }
  ],
  "packages": {
    "go": {
      "release-type": "go",
      "component": "go",
      "package-name": "github.com/inorbithr/sdk/go",
      "extra-files": ["version.go"]
    },
    "rust": {
      "release-type": "rust",
      "component": "rust",
      "package-name": "inorbithr",
      "extra-files": [
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='inorbithr')].version" },
        { "type": "toml", "path": "/cli/Cargo.lock", "jsonpath": "$.package[?(@.name.value==='inorbithr')].version" },
        { "type": "toml", "path": "/examples/rust/Cargo.lock", "jsonpath": "$.package[?(@.name.value==='inorbithr')].version" }
      ]
    },
    "typescript": {
      "release-type": "node",
      "component": "typescript",
      "package-name": "@inorbithr/sdk",
      "extra-files": [
        { "type": "json", "path": "jsr.json", "jsonpath": "$.version" },
        "src/version.ts"
      ]
    },
    "python": {
      "release-type": "python",
      "component": "python",
      "package-name": "inorbithr",
      "extra-files": [
        { "type": "toml", "path": "uv.lock", "jsonpath": "$.package[?(@.name.value==='inorbithr')].version" }
      ]
    },
    "csharp": {
      "release-type": "simple",
      "component": "csharp",
      "package-name": "InOrbit.Sdk",
      "extra-files": ["src/InOrbit.Sdk/InOrbit.Sdk.csproj"]
    },
    "java": {
      "release-type": "simple",
      "component": "java",
      "package-name": "hr.inorbit:inorbit-sdk",
      "extra-files": ["pom.xml", "src/main/java/hr/inorbit/sdk/Client.java"]
    },
    "cli": {
      "release-type": "simple",
      "component": "iohr",
      "package-name": "iohr",
      "versioning": "prerelease",
      "prerelease": true,
      "prerelease-type": "alpha",
      "extra-files": [
        { "type": "toml", "path": "Cargo.toml", "jsonpath": "$.workspace.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='iohr')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='iohr-auth')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='iohr-openapi')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='iohr-codegen')].version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(@.name.value==='iohr-lab')].version" }
      ]
    }
  }
}
