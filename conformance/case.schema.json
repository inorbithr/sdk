{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/inorbithr/sdk/conformance/case.schema.json",
  "title": "Conformance case",
  "type": "object",
  "required": ["name", "area", "summary", "action", "exchanges", "expect"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "area": { "enum": ["auth", "errors", "retries", "operations", "sse", "socket"] },
    "summary": { "type": "string" },
    "pending": { "type": "array", "items": { "enum": ["go", "rust", "ts", "py", "java", "csharp"] }, "description": "Languages that do not pass yet; each needs an issue link in `notes`." },
    "notes": { "type": "string" },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_retries": { "type": "integer", "minimum": 0 },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "key_id": { "type": "string" },
        "key_secret": { "type": "string" },
        "scopes": { "type": "array", "items": { "type": "string" }, "description": "Scopes the client asks for; default [identity:read]." }
      }
    },
    "action": {
      "type": "object",
      "required": ["op"],
      "additionalProperties": false,
      "properties": {
        "op": { "enum": ["me", "accounts.get_me", "accounts.get_usage", "radar.get_digest", "events.create_endpoint", "events.delete_endpoint"] },
        "args": { "type": "object" },
        "repeat": { "type": "integer", "minimum": 1, "description": "Run the action this many times on one client." },
        "concurrent": { "type": "integer", "minimum": 1, "description": "Run the action this many times at once on one client." }
      }
    },
    "exchanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["request"],
        "additionalProperties": false,
        "properties": {
          "request": {
            "type": "object",
            "required": ["method", "path"],
            "additionalProperties": false,
            "properties": {
              "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
              "path": { "type": "string" },
              "query": { "type": "object", "additionalProperties": { "type": "string" } },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "form": { "type": "object", "additionalProperties": { "type": "string" } },
              "json": {},
              "min_delay_ms": { "type": "integer", "minimum": 0 },
              "max_delay_ms": { "type": "integer", "minimum": 0 }
            }
          },
          "response": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": { "type": "integer" },
              "headers": { "type": "object", "additionalProperties": { "type": "string" } },
              "json": {},
              "text": { "type": "string" },
              "delay_ms": { "type": "integer", "minimum": 0 },
              "fault": { "enum": ["reset"] },
              "chunked": {
                "type": "object",
                "description": "Send the body with chunked transfer encoding, `bytes` at a time, waiting `delay_ms` between chunks (a slow body).",
                "required": ["bytes"],
                "additionalProperties": false,
                "properties": {
                  "bytes": { "type": "integer", "minimum": 1 },
                  "delay_ms": { "type": "integer", "minimum": 0 }
                }
              }
            }
          }
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ok": { "description": "Subset of the typed result, in wire names." },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": { "enum": ["api", "connection", "timeout", "auth", "config"] },
            "code": { "type": "string" },
            "status": { "type": "integer" },
            "details": { "type": "array" },
            "message_contains": { "type": "string" },
            "message_excludes": { "type": "string" }
          }
        },
        "attempts": { "type": "integer", "minimum": 1 },
        "token_exchanges": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
