//! The operations, grouped by area. [`Surface`] is implemented for `Client<P>` for the
//! profiles of this surface; each operation is callable only where its marker in
//! [`ops`](super::ops) is implemented.

use std::future::Future;

{% if paged %}
use {{ runtime }}::__codegen::{pages, path_segment};
{% else %}
use {{ runtime }}::__codegen::path_segment;
{% endif %}
use {{ runtime }}::{Client, Error, {% if streamed %}EventStream, {% endif %}Method, Operation, {% if paged %}Pages, {% endif %}Profile, Response};
use super::models::*;
use super::ops;

{%- macro signature(op) -%}
(&self{% for a in op.path_args %}, {{ a }}: &str{% endfor %}{% if op.params_type %}, params: &{{ op.params_type }}{% endif %}{% if op.body_type %}, body: &{{ op.body_type }}{% endif %})
{%- endmacro -%}

{%- macro build(op) -%}
Operation::new(Method::{{ op.method }}, {% if op.path_literal %}"{{ op.path_literal }}"{% else %}format!("{{ op.path_format }}"{% for a in op.path_args %}, path_segment({{ a }}){% endfor %}){% endif %})
    .named("{{ op.hook_name }}")
    .scopes(&[{% for s in op.scopes %}"{{ s }}", {% endfor %}])
    .template("{{ op.template }}")
    {%- if op.idempotent %}
    .idempotent(true)
    {%- endif %}
    {%- if op.idempotency_key %}
    .idempotency_key(true)
    {%- endif %}
    {%- for q in op.query %}
    {%- if q.is_vec %}
    .query_each("{{ q.name }}", params.{{ q.field }}.iter().flatten().map(ToString::to_string))
    {%- else %}
    .query_opt("{{ q.name }}", params.{{ q.field }}.as_ref().map(ToString::to_string))
    {%- endif %}
    {%- endfor %}
    {%- if op.body_type %}
    .json(body)?
    {%- endif %}
    {%- if op.stream and op.rpc %}
    .rpc("{{ op.rpc }}")
    {%- for a in op.path_args %}
    .field("{{ op.path_wire[loop.index0] }}", {{ a }})
    {%- endfor %}
    {%- for q in op.query %}
    .field_opt("{{ q.name }}", params.{{ q.field }}.as_ref())
    {%- endfor %}
    {%- endif %}
{%- endmacro -%}

{%- macro answer(op) -%}
{% if op.stream %}EventStream<{{ op.response_type }}>{% else %}Response<{{ op.response_type }}>{% endif %}
{%- endmacro -%}

{%- macro scopes_line(op) -%}
`{{ op.line }}`{% if op.scopes %}; needs scope{% if op.scopes|length > 1 %}s{% endif %} {% for s in op.scopes %}`{{ s }}`{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}.{% if op.stream %} A stream of events: see [`EventStream`].{% endif %}
{%- endmacro -%}

/// The operations, as methods on [`Client`].
pub trait Surface<P: Profile> {
{% for h in handles %}
    /// The `{{ h.tag }}` operations.
    fn {{ h.method_name }}(&self) -> {{ h.type_name }}<'_, P>;
{% endfor %}
{% for op in flat %}
    /// {{ scopes_line(op) }}
    fn {{ op.name }}{{ signature(op) }} -> impl Future<Output = Result<{{ answer(op) }}, Error>> + Send
    where
        P: ops::{{ op.marker }};
{% endfor %}
}

impl<P: Profile> Surface<P> for Client<P> {
{% for h in handles %}
    fn {{ h.method_name }}(&self) -> {{ h.type_name }}<'_, P> {
        {{ h.type_name }}(self)
    }
{% endfor %}
{% for op in flat %}
    fn {{ op.name }}{{ signature(op) }} -> impl Future<Output = Result<{{ answer(op) }}, Error>> + Send
    where
        P: ops::{{ op.marker }},
    {
        async move {
            let op = {{ build(op) }};
            self.{% if op.stream %}stream{% else %}request{% endif %}(op).await
        }
    }
{% endfor %}
}

{% for h in handles %}
/// The `{{ h.tag }}` operations of a client.
#[derive(Debug, Clone, Copy)]
pub struct {{ h.type_name }}<'a, P: Profile>(&'a Client<P>);

{% for op in h.ops %}
impl<P: ops::{{ op.marker }}> {{ h.type_name }}<'_, P> {
    /// {{ scopes_line(op) }}
    pub async fn {{ op.name }}{{ signature(op) }} -> Result<{{ answer(op) }}, Error> {
        let op = {{ build(op) }};
        self.0.{% if op.stream %}stream{% else %}request{% endif %}(op).await
    }
{% if op.paging %}

    /// Every item `{{ op.line }}` answers, page after page, following the next-page token
    /// until the last page; see [`Pages`].
    pub fn all_{{ op.name }}(&self{% for a in op.path_args %}, {{ a }}: &str{% endfor %}, params: &{{ op.params_type }}) -> Pages<'_, {{ op.paging.item }}> {
        let client = self.0;
        {% for a in op.path_args %}let {{ a }} = {{ a }}.to_owned();
        {% endfor %}let params = params.clone();
        pages(Box::new(move |token| {
            let mut params = params.clone();
            if token.is_some() {
                params.{{ op.paging.token_field }} = token;
            }
            {% for a in op.path_args %}let {{ a }} = {{ a }}.clone();
            {% endfor %}Box::pin(async move {
                let page = Self(client).{{ op.name }}({% for a in op.path_args %}&{{ a }}, {% endfor %}&params).await?.value;
                Ok((page.{{ op.paging.list }}, page.{{ op.paging.next }}))
            })
        }))
    }
{% endif %}}
{% endfor %}
{% endfor %}

{% for s in params_structs %}
/// The query parameters of `{{ s.op_line }}`; every field is optional.
#[derive(Debug, Clone, Default, PartialEq)]
pub struct {{ s.type_name }} {
{% for f in s.fields %}
    {% if f.doc %}/// {{ f.doc }}{% else %}/// `{{ f.name }}`{% endif %}
    pub {{ f.field }}: ::std::option::Option<{{ f.ty }}>,
{% endfor %}
}
{% endfor %}
