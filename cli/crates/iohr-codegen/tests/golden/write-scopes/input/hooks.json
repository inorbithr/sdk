            "type": "string"
          },
          "secret": {
            "type": "string"
          }
        },
        "required": [
          "secret",
          "previous_expires_at"
        ],
        "type": "object"
      },
      "SendTestResponse": {
        "description": "`iohr.events.v1.SendTestResponse`",
