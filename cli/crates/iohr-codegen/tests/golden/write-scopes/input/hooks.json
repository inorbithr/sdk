{
  "components": {
    "schemas": {
      "Code": {
        "description": "The stable error vocabulary. The slug (`snake_case`) is what clients see in\n`code`; the HTTP status follows the standard gRPC mapping, plus the two\nHTTP-only codes for request bodies.",
        "enum": [
          "bad_request",
          "not_found",
          "already_exists",
          "conflict",
          "forbidden",
          "unauthenticated",
          "rate_limited",
          "quota_exceeded",
          "failed_precondition",
          "unimplemented",
          "unavailable",
          "timeout",
          "cancelled",
          "internal",
          "unsupported_media_type",
          "payload_too_large",
          "method_not_allowed",
          "unprocessable"
        ],
        "type": "string",
        "x-http-status": {
          "already_exists": 409,
          "bad_request": 400,
          "cancelled": 499,
          "conflict": 409,
          "failed_precondition": 400,
          "forbidden": 403,
          "internal": 500,
          "method_not_allowed": 405,
          "not_found": 404,
          "payload_too_large": 413,
          "quota_exceeded": 429,
          "rate_limited": 429,
          "timeout": 504,
          "unauthenticated": 401,
          "unavailable": 503,
          "unimplemented": 501,
          "unprocessable": 422,
          "unsupported_media_type": 415
        }
      },
      "CreateEndpointRequest": {
        "description": "`iohr.events.v1.CreateEndpointRequest`",
        "properties": {
          "account_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "event_types": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "url": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreateEndpointResponse": {
        "description": "`iohr.events.v1.CreateEndpointResponse`",
        "properties": {
          "endpoint": {
            "$ref": "#/components/schemas/Endpoint"
          },
          "secret": {
            "type": "string"
          }
        },
        "required": [
          "secret"
        ],
        "type": "object"
      },
      "CreateInboxRequest": {
        "description": "`iohr.events.v1.CreateInboxRequest`",
        "properties": {
          "account_id": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "CreateInboxResponse": {
        "description": "`iohr.events.v1.CreateInboxResponse`",
        "properties": {
          "inbox": {
            "$ref": "#/components/schemas/Inbox"
          }
        },
        "type": "object"
      },
      "DeleteEndpointResponse": {
        "description": "`iohr.events.v1.DeleteEndpointResponse`",
        "type": "object"
      },
      "DeleteInboxResponse": {
        "description": "`iohr.events.v1.DeleteInboxResponse`",
        "type": "object"
      },
      "Delivery": {
        "description": "`iohr.events.v1.Delivery`",
        "properties": {
          "attempts": {
            "format": "int32",
            "type": "integer"
          },
          "created_at": {
            "type": "string"
          },
          "endpoint_id": {
            "type": "string"
          },
          "event_id": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "last_error": {
            "type": "string"
          },
          "last_latency_ms": {
            "format": "int32",
            "type": "integer"
          },
          "last_status_code": {
            "format": "int32",
            "type": "integer"
          },
          "next_attempt_at": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "updated_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "endpoint_id",
          "event_id",
          "event_type",
          "status",
          "attempts",
          "last_status_code",
          "last_latency_ms",
          "last_error",
          "next_attempt_at",
          "created_at",
          "updated_at"
        ],
        "type": "object"
      },
      "Detail": {
        "description": "A typed detail, translated from `google.rpc` error details.",
        "discriminator": {
          "propertyName": "type"
        },
        "oneOf": [
          {
            "description": "`google.rpc.BadRequest.FieldViolation`: which field, and why.",
            "properties": {
              "description": {
                "description": "What is wrong with it.",
                "type": "string"
              },
              "field": {
                "description": "Field path in the request.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "field"
                ],
                "type": "string"
              }
            },
            "required": [
              "field",
              "description",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "`google.rpc.ErrorInfo`: a machine-readable reason.",
            "properties": {
              "domain": {
                "description": "Who owns the reason.",
                "type": "string"
              },
              "metadata": {
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Extra key/values.",
                "propertyNames": {
                  "type": "string"
                },
                "type": "object"
              },
              "reason": {
                "description": "Reason, `UPPER_SNAKE_CASE` by convention.",
                "type": "string"
              },
              "type": {
                "enum": [
                  "info"
                ],
                "type": "string"
              }
            },
            "required": [
              "reason",
              "domain",
              "metadata",
              "type"
            ],
            "type": "object"
          },
          {
            "description": "`google.rpc.RetryInfo`: when to try again; also the `Retry-After` header.",
            "properties": {
              "after_seconds": {
                "description": "Seconds to wait, rounded up.",
                "format": "int64",
                "minimum": 0,
                "type": "integer"
              },
              "type": {
                "enum": [
                  "retry"
                ],
                "type": "string"
              }
            },
            "required": [
              "after_seconds",
              "type"
            ],
            "type": "object"
          }
        ]
      },
      "Endpoint": {
        "description": "`iohr.events.v1.Endpoint`",
        "properties": {
          "created_at": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "disabled_reason": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          },
          "event_types": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "failed_24h": {
            "format": "int32",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "last_delivery_at": {
            "type": "string"
          },
          "last_delivery_status": {
            "type": "string"
          },
          "secret_rotated_at": {
            "type": "string"
          },
          "succeeded_24h": {
            "format": "int32",
            "type": "integer"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "description",
          "event_types",
          "enabled",
          "disabled_reason",
          "created_at",
          "secret_rotated_at",
          "last_delivery_at",
          "last_delivery_status",
          "succeeded_24h",
          "failed_24h"
        ],
        "type": "object"
      },
      "Inbox": {
        "description": "`iohr.events.v1.Inbox`",
        "properties": {
          "created_at": {
            "type": "string"
          },
          "expires_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "url",
          "created_at",
          "expires_at"
        ],
        "type": "object"
      },
      "Problem": {
        "description": "`{\"code\",\"error\",\"details\",\"request_id\"}`: the REST body and the SSE `error` payload.",
        "properties": {
          "code": {
            "$ref": "#/components/schemas/Code",
            "description": "The slug."
          },
          "details": {
            "description": "Typed details.",
            "items": {
              "$ref": "#/components/schemas/Detail"
            },
            "type": "array"
          },
          "error": {
            "description": "The sentence.",
            "type": "string"
          },
          "request_id": {
            "description": "The request's id, the `x-request-id` the answer carries: name it when\nasking about a call. Empty on a socket or MQTT frame, whose own id\nnames the call.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "error",
          "details",
          "request_id"
        ],
        "type": "object"
      },
      "RetryDeliveryResponse": {
        "description": "`iohr.events.v1.RetryDeliveryResponse`",
        "properties": {
          "delivery": {
            "$ref": "#/components/schemas/Delivery"
          }
        },
        "type": "object"
      },
      "RotateSecretResponse": {
        "description": "`iohr.events.v1.RotateSecretResponse`",
