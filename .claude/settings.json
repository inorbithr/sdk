{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Edit(./spec/*.json)",
      "Edit(./spec/SOURCE)",
      "Edit(./**/generated/**)",
      "Edit(./**/_generated/**)",
      "Edit(./python/src/inorbithr/_sync/**)",
      "Edit(./**/CHANGELOG.md)",
      "Edit(./.release-please-manifest.json)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(npm publish *)",
      "Bash(pnpm publish *)",
      "Bash(cargo publish *)",
      "Bash(uv publish *)",
      "Bash(twine *)",
      "Bash(mvn deploy*)",
      "Bash(mvn *:deploy*)",
      "Bash(dotnet nuget push *)"
    ]
  }
}
